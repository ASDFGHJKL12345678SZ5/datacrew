# ---- 复制本文件为 .env 并填入真实值；.env 永不提交 ----

# 应用
APP_ENV=dev
LOG_LEVEL=INFO

# PostgreSQL（compose 里的密码需与此处一致）
POSTGRES_PASSWORD=postgres
PG_ADMIN_DSN=postgresql://postgres:postgres@localhost:5432/ecommerce
PG_RO_DSN=postgresql://datacrew_ro:datacrew_ro_pwd@localhost:5432/ecommerce

# Redis
REDIS_URL=redis://localhost:6379/0

# 对象存储（适配器：local 本地磁盘 / minio 对象存储）
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=data/storage
# MinIO（仅 STORAGE_BACKEND=minio 时生效）
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=datacrew
MINIO_SECURE=false

# LLM（OpenAI 兼容协议：DeepSeek / 通义 / 任何兼容服务一套客户端）
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_SMALL_MODEL=deepseek-chat
# mock=规则假模型（无 key 跑通全链路，CI 默认）；real=真实 LLM（配好 key 后改）
LLM_MODE=mock

# 安全
API_KEYS=dev-key-001
RATE_LIMIT_PER_MIN=20
SQL_ROW_LIMIT=1000
SQL_TIMEOUT_MS=3000

# Langfuse（留空则 trace 降级为本地日志，不报错）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
